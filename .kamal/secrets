# Loaded at deploy time from ~/.config/fbc-chms/deploy.env (kept off the repo, chmod 600).
# That file holds one line: POSTGRES_PASSWORD=<long random string>
POSTGRES_PASSWORD=$(grep ^POSTGRES_PASSWORD= ~/.config/fbc-chms/deploy.env | cut -d= -f2-)
DATABASE_URL=postgres://fbc:$POSTGRES_PASSWORD@fbc_chms-db:5432/fbc_chms
