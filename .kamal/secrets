# Loaded at deploy time from ~/.config/fbc-chms/deploy.env (kept off the repo, chmod 600).
# That file holds one line: POSTGRES_PASSWORD=<long random string>
POSTGRES_PASSWORD=$(grep ^POSTGRES_PASSWORD= ~/.config/fbc-chms/deploy.env | cut -d= -f2-)
DATABASE_URL=postgres://fbc:$POSTGRES_PASSWORD@fbc_chms-db:5432/fbc_chms

# Facebook Page for the Monday sermon posts, from ~/.config/fbc-chms/facebook.env (chmod 600):
# FACEBOOK_PAGE_ID=<page id> and FACEBOOK_PAGE_TOKEN=<page access token>. Blank turns posting off.
FACEBOOK_PAGE_ID=$(grep ^FACEBOOK_PAGE_ID= ~/.config/fbc-chms/facebook.env 2>/dev/null | cut -d= -f2-)
FACEBOOK_PAGE_TOKEN=$(grep ^FACEBOOK_PAGE_TOKEN= ~/.config/fbc-chms/facebook.env 2>/dev/null | cut -d= -f2-)
